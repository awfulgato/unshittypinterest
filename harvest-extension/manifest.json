{
  "manifest_version": 2,
  "name": "Eskja Segl + Poki v0",
  "version": "0.4.0",
  "description": "Segl gathers chosen things into Poki; keep sends them into Eskja.",
  "permissions": [
    "<all_urls>",
    "activeTab",
    "tabs",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Eskja",
    "default_popup": "sidebar.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "segl@eskja.local",
      "strict_min_version": "109.0"
    }
  }
}
